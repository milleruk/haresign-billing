# haresign-billing — environment template.
#
# Copy to `.env` for a local stack. **Never commit a real value.** In the
# permanent deployment every secret is a file under /opt/docker/secrets/ and is
# read through the `<NAME>_FILE` form by config/secret_entrypoint.py, so no
# secret is ever an environment variable in a process listing.
#
# Anything marked REQUIRED has no default and the application refuses to start
# without it.

# --- Core --------------------------------------------------------------------
DEBUG=0
# REQUIRED when DEBUG=0. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Comma-separated. A wildcard is refused when DEBUG=0.
ALLOWED_HOSTS=localhost,127.0.0.1
# The canonical public address. Used to build the OIDC redirect URI, and never
# read from the request Host header.
SITE_BASE_URL=http://localhost:8000
# Any non-empty value marks this as a non-production environment and renders a
# badge. Production sets it empty.
ENVIRONMENT_LABEL=Phase 4A
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# This service's own PostgreSQL. Never the monolith's, never Identity's.
POSTGRES_DB=haresign_billing
POSTGRES_USER=haresign_billing
POSTGRES_PASSWORD=
POSTGRES_HOST=billing_db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Cache -------------------------------------------------------------------
# REQUIRED when DEBUG=0. Backs endpoint throttling, which fails closed.
REDIS_URL=redis://billing_redis:6379/0

# --- Haresign Identity (OIDC relying party) -----------------------------------
# Ships OFF. No production relying-party client exists; creating one is an
# authorised cutover step. With OIDC_ENABLED=0 the sign-in route answers 503.
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must be absolute and under SITE_BASE_URL. Registered exactly at the provider.
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid,profile,email,haresign:memberships
OIDC_CLOCK_SKEW=60
OIDC_STATE_TTL=600
# Only ever 1 in the isolated rehearsal, which speaks plain HTTP on a private
# bridge with no route out.
OIDC_ALLOW_INSECURE_LOOPBACK=0
# Seconds. How long a membership claim captured at sign-in may be relied on
# before the session must re-authorize. Short on purpose: an ID token is a
# snapshot, and somebody removed from an organisation must lose billing access
# promptly.
IDENTITY_MEMBERSHIP_MAX_AGE=900
# Where to send someone to manage the organisation itself. Optional.
HARESIGN_IDENTITY_URL=

# --- Payment provider ---------------------------------------------------------
# `fake` is the deterministic in-process provider and is the only value any
# environment in this phase uses. Setting `stripe` additionally requires
# STRIPE_SECRET_KEY, and doing so is prohibited until an authorised cutover —
# see AGENTS.md, "The Stripe boundary".
PROVIDER_BACKEND=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pinned alongside the SDK version in requirements.txt, because an SDK upgrade
# can otherwise change the default API version and with it the shape of every
# webhook this service parses.
STRIPE_API_VERSION=2025-10-29.clover
# Whether hosted checkout and portal links are offered. Off until cutover.
BILLING_CHECKOUT_ENABLED=0

# --- Entitlement API ----------------------------------------------------------
# Comma-separated `key_id:secret` pairs. More than one may be configured at
# once, which is what makes rotation overlap-capable: add the new pair, deploy
# consumers, remove the old pair. Empty means the API is CLOSED, not open.
ENTITLEMENT_API_KEYS=
# Seconds a consumer may cache an entitlement answer, advertised in the response.
ENTITLEMENT_CACHE_SECONDS=60

# --- Security -----------------------------------------------------------------
# Production is 0: a cache outage must not silently remove rate limiting.
THROTTLE_FAIL_OPEN=0
# Number of proxies in front of the application. Only this many rightmost
# X-Forwarded-For entries are trusted.
TRUSTED_PROXY_COUNT=1
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
CSP_UPGRADE_INSECURE_REQUESTS=1
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_AGE=28800

# --- Company identity ---------------------------------------------------------
# The same variable names the rest of the estate uses. Every one defaults to
# empty and the footer omits an unset value entirely.
LEGAL_COMPANY_NAME=Haresign
LEGAL_COMPANY_NUMBER=
LEGAL_REGISTERED_ADDRESS=
LEGAL_ICO_REGISTRATION=
LEGAL_CONTACT_EMAIL=
HARESIGN_WEB_URL=https://haresign.net
